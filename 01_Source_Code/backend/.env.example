# DroneTV AI Support & Lead Assistant - Environment Configuration Template
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (MongoDB URI with optional credentials)
MONGODB_URI=mongodb://127.0.0.1:27017/dronetv_db

# Fallback store toggle: Set to true to fallback to persistent local JSON datastore if MongoDB is unavailable
USE_FALLBACK_STORE=true

# Administrator Credentials (Set strong password in production)
ADMIN_EMAIL=admin@dronetv.in
ADMIN_PASSWORD=your_strong_admin_password_here

# Cryptographic Session Secret (Generate a strong 64-char random hex key in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
ADMIN_SESSION_EXPIRY_HOURS=24
